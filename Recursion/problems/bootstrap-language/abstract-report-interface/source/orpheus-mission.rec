  heading
    eyebrow: "DEEP-SPACE MISSION / SIMULATION DATASET 07"
    title: "ORPHEUS mission operations"
    subtitle: "A live operational snapshot of spacecraft health, recent events, and the next mission gates. Two planning alerts remain unresolved."
    meta: "MISSION DAY 184 · 142.8 M KM FROM EARTH · SIMULATION"
  feature
    label: "UPCOMING MISSION GATES"
    title: "Three milestones on the flight plan"
    text: "Day 190 — Solar array reorientation; dependency: battery reserve recovery. Day 197 — Deep-space signal relay; dependency: communications alignment. Day 205 — Orbital insertion rehearsal; dependency: navigation validation."
    status: "Next: day 190"
    tooltip: "Milestone dates and dependencies are planning data from the supplied simulation dataset."
  callout
    title: "Two planning alerts remain open"
    text: "Battery reserve is 31%, below the 35% planning threshold. Radiation exposure is 7.8 mSv/day, above the 0–6 mSv/day planning range. These are the two unresolved alerts; the other eight subsystems are nominal. All names, readings, thresholds, and events are invented for this experiment."
  metrics
    metric "Mission elapsed" | "184 days" | "Current mission day"
    metric "Distance from Earth" | "142.8 M km" | "Simulation telemetry"
    metric "Systems nominal" | "8 / 10" | "Two subsystems in warning state"
    metric "Active alerts" | "2" | "Battery reserve · Radiation exposure"
