    row "Navigation drift" | "0.014°" | "0–0.020°" | "Nominal"
    row "Life support O₂" | "21.1%" | "20–22%" | "Nominal"
    row "Coolant flow" | "18.6 L/s" | "17–21 L/s" | "Nominal"
