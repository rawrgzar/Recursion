    title: "Subsystem telemetry"
    search: "Search subsystem or reading"
    filter: "State"
    page_size: 10
    column "Subsystem"
    column "Reading"
    column "Nominal range"
    column "State"
    row "Reactor output" | "84.2 MW" | "75–90 MW" | "Nominal"
    row "Hull pressure" | "96.4 kPa" | "94–101 kPa" | "Nominal"
    row "Core temperature" | "418 K" | "390–430 K" | "Nominal"
